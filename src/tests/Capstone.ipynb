    "        opt_data['demand'], school_budgets, total_budget, waste_penalty, daily_bounds\n",
    "    )\n",
    "    generate_item_breakdown(results_df, opt_data['dfb'], opt_data['dfl'], '../data/school_food_item_optimization.csv')"
